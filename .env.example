# Environment Variables for Oluwasegun Design System

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/oluwasegun_design_system?schema=public"

# Cloudflare R2 Object Storage Credentials
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="oluwasegun-design-system-assets"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# SMTP Email Transporter Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Oluwasegun Design System <your_email@gmail.com>"
EMAIL_FROM="Oluwasegun Design System <your_email@gmail.com>"

